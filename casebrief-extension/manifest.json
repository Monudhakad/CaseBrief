{
  "manifest_version": 3,
  "name": "CaseBrief",
  "version": "1.0.0",
  "description": "Local structured case-brief processing for PDF reports.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CaseBrief",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "assets/icons/casebrief.png"
    }
  },
  "icons": {
    "128": "assets/icons/casebrief.png"
  }
}
